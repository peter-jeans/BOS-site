{
  "description": "Project-scoped assistance choices and bounded proactive context; no service calls or trust bypass.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/bootstrap-codex.sh\" SessionStart",
            "timeout": 5,
            "statusMessage": "BOS / Public / cloudbos-public-plugin \u2014 Read project and assistance settings at startup",
            "commandWindows": "cmd.exe /d /s /c call \"${PLUGIN_ROOT}/scripts/bootstrap-codex.cmd\" SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/bootstrap-codex.sh\" UserPromptSubmit",
            "timeout": 5,
            "statusMessage": "BOS / Public / cloudbos-public-plugin \u2014 Check assistance requests and relevant guidance",
            "commandWindows": "cmd.exe /d /s /c call \"${PLUGIN_ROOT}/scripts/bootstrap-codex.cmd\" UserPromptSubmit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*cloudbos.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/bootstrap-codex.sh\" PreToolUse",
            "timeout": 5,
            "statusMessage": "BOS / Public / cloudbos-public-plugin \u2014 Check project and assistance settings before Cloud calls",
            "commandWindows": "cmd.exe /d /s /c call \"${PLUGIN_ROOT}/scripts/bootstrap-codex.cmd\" PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|apply_patch|exec_command|functions\\.exec_command|functions\\.apply_patch|.*cloudbos.*__bos_assistance_preference",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/bootstrap-codex.sh\" PostToolUse",
            "timeout": 5,
            "statusMessage": "BOS / Public / cloudbos-public-plugin \u2014 Check tool results and repeated failures",
            "commandWindows": "cmd.exe /d /s /c call \"${PLUGIN_ROOT}/scripts/bootstrap-codex.cmd\" PostToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/bootstrap-codex.sh\" Stop",
            "timeout": 5,
            "statusMessage": "BOS / Public / cloudbos-public-plugin \u2014 Clear one-request assistance state",
            "commandWindows": "cmd.exe /d /s /c call \"${PLUGIN_ROOT}/scripts/bootstrap-codex.cmd\" Stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/bootstrap-codex.sh\" SessionEnd",
            "timeout": 3,
            "statusMessage": "BOS / Public / cloudbos-public-plugin \u2014 Remove temporary session records",
            "commandWindows": "cmd.exe /d /s /c call \"${PLUGIN_ROOT}/scripts/bootstrap-codex.cmd\" SessionEnd"
          }
        ]
      }
    ]
  }
}
