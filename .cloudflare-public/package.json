{
  "name": "bos-public-site-hosting",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node build.mjs --check",
    "build": "node build.mjs",
    "dry-run": "wrangler deploy --dry-run --config wrangler.json",
    "deploy": "node release-check.mjs && npm run build && wrangler deploy --config wrangler.production.json"
  },
  "devDependencies": {
    "wrangler": "4.125.0"
  }
}
