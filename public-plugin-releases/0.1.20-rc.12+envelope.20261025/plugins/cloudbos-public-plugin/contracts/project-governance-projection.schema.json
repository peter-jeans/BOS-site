{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudbos.example/schemas/project-governance-projection-v1.json",
  "title": "Cloud BOS Public Project Governance Projection V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "projection_version", "projection_hash", "project_identity", "authority", "governance", "permissions", "capability_currentness", "cloud_binding", "evidence_locations", "manifest", "lifecycle"],
  "properties": {
    "schema": {"const": "BOS_CLOUDBOS_PUBLIC_PROJECT_GOVERNANCE_PROJECTION_V1"},
    "projection_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "projection_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "project_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "project_ref", "environment"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "project_ref": {"type": "string", "minLength": 1},
        "environment": {"enum": ["LOCAL_REPOSITORY", "GITHUB_REPOSITORY", "BASE44_GOVERNED_APP", "BASE44_DIRECT_APP", "REMOTE_NO_WRITE"]}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "deployment"],
      "properties": {
        "source": {"enum": ["LOCAL_OWNER", "GITHUB_OWNER", "BASE44_APP_OWNER", "READ_ONLY", "UNKNOWN"]},
        "deployment": {"enum": ["SEPARATE_APPROVAL_REQUIRED", "OWNER_CONTROLLED", "READ_ONLY", "UNKNOWN"]}
      }
    },
    "governance": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "profile", "profile_version", "state"],
      "properties": {
        "mode": {"const": "PUBLIC_PROJECT_GOVERNANCE"},
        "profile": {"type": "string", "minLength": 1},
        "profile_version": {"type": "string", "minLength": 1},
        "state": {"enum": ["GOVERNANCE_PLAN_READY", "GOVERNED_ACTIVE", "STALE_OR_DRIFTED", "DETACHED_OR_REMOVED"]}
      }
    },
    "permissions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "capability_currentness": {"type": "object", "additionalProperties": {"enum": ["AVAILABLE", "NOT_ENTITLED", "STALE", "UNAVAILABLE", "UNKNOWN"]}},
    "cloud_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["platform_installation_id", "project_binding_id", "resource_uri", "status"],
      "properties": {
        "platform_installation_id": {"type": "string", "minLength": 1},
        "project_binding_id": {"type": "string", "minLength": 1},
        "resource_uri": {"type": "string", "format": "uri"},
        "status": {"enum": ["PENDING_VERIFICATION", "VERIFIED", "STALE", "DETACHED"]}
      }
    },
    "evidence_locations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "manifest": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "target", "role", "sha256", "bytes", "removable"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "removable": {"const": true}
        }
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["update", "rollback", "removal", "drift_detection"],
      "properties": {
        "update": {"type": "string", "minLength": 1},
        "rollback": {"type": "string", "minLength": 1},
        "removal": {"type": "string", "minLength": 1},
        "drift_detection": {"type": "string", "minLength": 1}
      }
    }
  }
}
